# ============================================================
# 环境变量模板 — 复制为 .env 并填入真实值
# 注意：.env 文件已被 .gitignore 忽略，不会上传到 Git
# ============================================================

# 示例：OpenAI API Key
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 示例：其他服务 API Key
# MY_SERVICE_API_KEY=your_api_key_here

# 示例：数据库连接
# DB_PASSWORD=your_password_here
